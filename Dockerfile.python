# Base image for the agent and dispatch services.
# Two stages: deps (install Python deps once, cache aggressively) and runtime (slim).

FROM python:3.11-slim AS deps
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml ./
RUN uv pip install --system --no-cache .

FROM python:3.11-slim AS runtime
WORKDIR /app

# tini reaps zombies and forwards SIGTERM to the Python process so that
# agent shutdown callbacks (out/<run_id>/ flush) run on `docker stop`.
#
# libgl1 / libegl1 / libgl1-mesa-dri provide the EGL + software-OpenGL
# stack the agent's shader-based avatar renderer (src/avatar_render.py)
# loads via moderngl.create_standalone_context(backend="egl"). Mesa's
# llvmpipe rasterizer runs on CPU, so no GPU is required on the host.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tini \
        libgl1 \
        libegl1 \
        libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# Force Mesa to use its software rasterizer (llvmpipe) — there is no GPU
# in the production VM, and without this hint Mesa tries DRI device nodes
# that don't exist and falls back to errors instead of swrast.
ENV LIBGL_ALWAYS_SOFTWARE=1

COPY --from=deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

COPY src/ ./src/
COPY scripts/ ./scripts/

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["/usr/bin/tini", "--"]
# No CMD — each compose service sets its own command.

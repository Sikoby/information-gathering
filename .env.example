# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# Redis — the agent ↔ webapp message bus.
# Inside docker compose this resolves to the redis service.
# For local non-docker dev, point at a host Redis (e.g. redis://localhost:6379/0).
REDIS_URL=redis://redis:6379/0

# Webapp container
WEBAPP_PORT=8765
# Public-facing URL the agent posts to the room chat. Override when tunneling.
WEBAPP_PUBLIC_URL=http://localhost:8765

# Dispatch container
DISPATCH_PORT=8766
# Used by scripts/dispatch.py when run from the host
DISPATCH_URL=http://localhost:8766

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# Redis — the agent ↔ meeting message bus.
# Inside docker compose this resolves to the redis service.
# For local non-docker dev, point at a host Redis (e.g. redis://localhost:6379/0).
REDIS_URL=redis://redis:6379/0

# Meeting participant tier (meeting API + meeting-frontend nginx).
# MEETING_PORT is the backend API port; meeting-frontend (nginx, :8765) proxies
# /api to it and serves the SPA.
MEETING_PORT=8771
# Public-facing URL (the meeting-frontend) the agent posts to the room chat and
# the console stamps into invite links. Override when tunneling.
MEETING_PUBLIC_URL=http://localhost:8765

# Dispatch container
DISPATCH_PORT=8766
# Used by scripts/dispatch.py when run from the host
DISPATCH_URL=http://localhost:8766

# Template generator container
TEMPLATE_GEN_PORT=8768
# Used by scripts/generate_template.py when run from the host
TEMPLATE_GEN_URL=http://localhost:8768
# OpenAI models for the implementation+critique loop. Default to gpt-5 for both;
# override to gpt-5-mini for cheaper iterations during development.
TEMPLATE_GEN_IMPL_MODEL=gpt-5
TEMPLATE_GEN_CRITIQUE_MODEL=gpt-5

# Console — meeting creation & lifecycle UI.
# The console-frontend (nginx) is the user-facing UI at http://localhost:8769
# CONSOLE_PORT is the backend API port; console-frontend proxies /api to it.
CONSOLE_PORT=8770
# Local-dev identity fallback. In prod, Cloudflare Access stamps
# Cf-Access-Authenticated-User-Email on every request and this is left empty.
# Locally there is no Cloudflare in front, so this email scopes every record
# you create. Override to "alice@x.test" / "bob@x.test" to simulate other users.
CONSOLE_DEV_USER_EMAIL=dev@local
# Optional tuning for the console background tasks:
# CONSOLE_GEN_MAX_ITERATIONS=3
# CONSOLE_RECONCILE_INTERVAL=15
# CONSOLE_STARTUP_GRACE_MIN=5
# A scheduled meeting overdue past this many hours (owner perpetually busy, or
# dispatch persistently failing) is retired done/schedule_missed.
# CONSOLE_SCHEDULE_LATE_CEILING_HOURS=6
# Prod only: Cloudflare team name (or full host) for the Sign out logout URL.
# CONSOLE_CF_TEAM_DOMAIN=myteam

# Invite email (SMTP). When a meeting is scheduled with invitees, the console
# emails each one the .ics plus a permanent join link + PIN (src/console/invites.py).
# Leave SMTP_HOST empty to disable sending (the .ics download still works and the
# send degrades to a logged no-op). Port 465 → implicit TLS; 587 → STARTTLS;
# anything else (e.g. a local mailpit on 1025) → plain. MEETING_PUBLIC_URL above
# is the base for the emailed join link (<base>/join/<meeting_id>), so set it to
# your public hostname when deployed.
#
# WORK IN PROGRESS: real outbound delivery isn't done yet. The supported way to
# test the invite path locally is the dev-only docker-compose.override.yml, which
# runs Mailpit (an open-source SMTP sink, inbox at http://localhost:8025) and
# points the console's SMTP there — no real mail server, no creds. The values
# below are only used if you remove that override and wire a real relay.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=meetings@your-domain.example

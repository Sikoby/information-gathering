# Slim webapp image: aiohttp + redis client + bundled meeting-viewer frontend.
# No livekit, no openai, no pydantic — the webapp deals only in opaque JSON.
# The frontend is an npm-workspace member; it is built inside the workspace so
# it can resolve the shared @ig/ui package.

FROM node:20-slim AS frontend-builder
WORKDIR /repo
# Copy the workspace manifests first so `npm ci` is cached on lockfile changes.
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/
COPY console-frontend/package.json ./console-frontend/
RUN npm ci
COPY shared/ ./shared/
COPY frontend/ ./frontend/
RUN npm run build -w frontend

FROM python:3.11-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir aiohttp redis loguru

COPY src/__init__.py ./src/__init__.py
COPY src/webapp/ ./src/webapp/
COPY --from=frontend-builder /repo/frontend/dist ./frontend/dist

ENV WEBAPP_PORT=8765
ENV PYTHONUNBUFFERED=1
EXPOSE 8765

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "src.webapp"]
